{
  "name": "dependabot-npm-force-overrides",
  "version": "1.1.1",
  "private": true,
  "description": "GitHub Action scaffold for enforcing npm override policy on Dependabot transitive dependency PRs.",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.7",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@oxc-project/types": ">=0.155.0",
    "@rolldown/binding-android-arm-eabi": ">=1.2.15",
    "@rolldown/binding-android-arm64": ">=1.2.15",
    "@rolldown/binding-darwin-arm64": ">=1.2.15",
    "@rolldown/binding-darwin-x64": ">=1.2.15",
    "@rolldown/binding-freebsd-x64": ">=1.2.15",
    "@rolldown/binding-linux-arm-gnueabihf": ">=1.2.15",
    "@rolldown/binding-linux-arm64-gnu": ">=1.2.15",
    "@rolldown/binding-linux-arm64-musl": ">=1.2.15",
    "@rolldown/binding-linux-ppc64-gnu": ">=1.2.15",
    "@rolldown/binding-linux-s390x-gnu": ">=1.2.15",
    "@rolldown/binding-linux-x64-gnu": ">=1.2.15",
    "@rolldown/binding-linux-x64-musl": ">=1.2.15",
    "@rolldown/binding-openharmony-arm64": ">=1.2.15",
    "@rolldown/binding-win32-arm64-msvc": ">=1.2.15",
    "@rolldown/binding-win32-x64-msvc": ">=1.2.15",
    "@vitest/expect": ">=4.1.12",
    "@vitest/mocker": ">=4.1.12",
    "@vitest/pretty-format": ">=4.1.12",
    "@vitest/runner": ">=4.1.12",
    "@vitest/snapshot": ">=4.1.12",
    "@vitest/spy": ">=4.1.12",
    "@vitest/utils": ">=4.1.12",
    "chai": ">=6.3.0",
    "nanoid": ">=3.3.20",
    "picomatch": ">=4.0.7",
    "postcss": ">=8.5.31",
    "rolldown": ">=1.2.15",
    "source-map-js": ">=1.2.2",
    "tinyrainbow": ">=3.2.0",
    "vite": ">=8.3.5"
  }
}
