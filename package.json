    "@esbuild/linux-riscv64": ">=0.28.2",
    "@esbuild/linux-s390x": ">=0.28.2",
    "@esbuild/linux-x64": ">=0.28.2",
    "@esbuild/netbsd-arm64": ">=0.28.2",
    "@esbuild/netbsd-x64": ">=0.28.2",
